---
import '../styles/global.css';
import EuEmblem from '../components/EuEmblem.astro';
import { url } from '../lib/url';
import { project } from '../data/project';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'GWCats is an EU-funded Marie Skłodowska-Curie Staff Exchanges network for gravitational-wave cosmology with galaxy catalogues.',
} = Astro.props;
const pageTitle = title ? `${title} | GWCats` : 'GWCats: gravitational-wave cosmology with galaxy catalogues';

const nav = [
  { href: 'project/', label: 'Project' },
  { href: 'network/', label: 'Network' },
  { href: 'workshops/', label: 'Workshops' },
];
const here = Astro.url.pathname.replace(/\/?$/, '/');
const ogImage = new URL(url('images/gwcats-hero.jpg'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Spectral:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url()} aria-label="GWCats home">
          <img src={url('images/gwcats-mark.png')} alt="" width="80" height="56" />
          <span>GWCats</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map(({ href, label }) => (
                <li>
                  <a href={url(href)} aria-current={here === url(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="funding">
          <div class="funding__mark">
            <EuEmblem />
            <span>Funded by the<br />European Union</span>
          </div>
          <p>
            GWCats has received funding from the European Union’s Horizon Europe research and innovation programme
            under the Marie Skłodowska-Curie grant agreement No&nbsp;{project.grantAgreement}.
          </p>
          <p class="funding__disclaimer">
            Views and opinions expressed are however those of the author(s) only and do not necessarily reflect
            those of the European Union or the European Research Executive Agency (REA). Neither the European Union
            nor the granting authority can be held responsible for them.
          </p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <ul>
            <li><a href={url()}>Home</a></li>
            {nav.map(({ href, label }) => <li><a href={url(href)}>{label}</a></li>)}
            <li><a href={project.cordis}>CORDIS record</a></li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
